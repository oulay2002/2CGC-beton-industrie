            "index": 0
          }
        ]
      ]
    },
    "Relais API 2CGC (CRM & Usine)": {
      "main": [
        [
          {
            "node": "Envoyer Réponse Client (WhatsApp Meta)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
