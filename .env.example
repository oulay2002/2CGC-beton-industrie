# ============================================================
# Variables d'environnement — 2CGC Béton Industrie
# Copier en .env.local et renseigner. Ne jamais committer .env.local.
# ============================================================

# --- Sécurité (OBLIGATOIRES) -------------------------------
# Signe les cookies de session. Sans lui, aucune connexion n'est possible.
# Générer avec : openssl rand -base64 32
AUTH_SECRET=

# Clé partagée avec le workflow n8n (Hostinger) pour /api/whatsapp/n8n-relay.
# Générer avec : openssl rand -hex 24
N8N_RELAY_API_KEY=

# Token de vérification du webhook Meta WhatsApp (Meta Developer Portal).
WHATSAPP_VERIFY_TOKEN=

# Secret applicatif Meta, utilisé pour valider la signature X-Hub-Signature-256
# des webhooks WhatsApp entrants. Meta Developer Portal > Paramètres > Général.
WHATSAPP_APP_SECRET=

# --- Base de données ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique. Depuis la migration 003 elle n'a plus aucun droit sur les
# tables : conservée uniquement pour l'URL du projet et un éventuel usage futur.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role — SERVEUR UNIQUEMENT, ne jamais préfixer NEXT_PUBLIC_.
# C'est elle qui porte tous les accès aux données applicatives.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email transactionnel (Resend) --------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
# Tant que le domaine d'envoi n'est pas vérifié chez Resend, tous les emails
# sont redirigés vers cette adresse.
RESEND_ADMIN_EMAIL=

# --- WhatsApp ----------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
N8N_WEBHOOK_URL=
WHATSAPP_COMMERCIAL=
NEXT_PUBLIC_WHATSAPP_COMMERCIAL=

# --- Divers -------------------------------------------------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
